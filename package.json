{
  "name": "@electron-publish-pro/cli",
  "version": "0.1.0",
  "description": "Command-line interface for Electron Publish Pro",
  "bin": {
    "epp": "./dist/cli.js",
    "electron-publish-pro": "./dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/cli.ts --format cjs --dts",
    "dev": "tsup src/cli.ts --format cjs --dts --watch",
    "lint": "eslint src/",
    "test": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "electron",
    "electron-builder",
    "cli",
    "publish",
    "code-signing",
    "notarization"
  ],
  "author": "Electron Publish Pro <hello@electronpublish.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/electron-publish-pro/cli.git"
  },
  "homepage": "https://electronpublish.com",
  "bugs": {
    "url": "https://github.com/electron-publish-pro/cli/issues"
  },
  "dependencies": {
    "@electron-publish-pro/sdk": "^0.1.0",
    "commander": "^12.0.0",
    "ora": "^8.0.0",
    "chalk": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  }
}
