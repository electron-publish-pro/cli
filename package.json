{
  "name": "electron-publish-pro",
  "version": "0.1.0",
  "description": "Run the Electron Publish Pro Release Readiness Check from your terminal, CI or an AI agent",
  "bin": {
    "epp": "./dist/cli.js"
  },
  "files": [
    "dist",
    "schema",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup src/cli.ts --format esm --target node18 --clean",
    "dev": "tsup src/cli.ts --format esm --target node18 --watch",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "release": "npm run build && changeset publish"
  },
  "keywords": [
    "electron",
    "electron-builder",
    "electron-forge",
    "code-signing",
    "notarization",
    "release",
    "cli"
  ],
  "author": "Electron Publish Pro <hello@electronpublish.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/electron-publish-pro/cli.git"
  },
  "homepage": "https://electronpublish.com",
  "bugs": {
    "url": "https://github.com/electron-publish-pro/cli/issues"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
